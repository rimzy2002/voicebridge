// Prisma Schema for Communication Platform
// 30-Day Communication Transformation Program

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Authentication & Users
// ============================================================

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String?
  image          String?
  role           String   @default("learner") // learner, coach, content_editor, admin, org_admin
  emailVerified  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  learnerProfile   LearnerProfile?
  sessions         Session[]
  accounts         Account[]
  recordings       Recording[]
  activityAttempts ActivityAttempt[]
  dayProgresses    DayProgress[]
  xpLedger         XpLedger[]
  badgeAwards      BadgeAward[]
  streak           Streak?
  consentRecords   ConsentRecord[]
  auditEvents      AuditEvent[]
  missionCompletions MissionCompletion[]
  confidenceChecks   ConfidenceCheck[]
  learnerVocabulary  LearnerVocabulary[]
  skillSnapshots     SkillSnapshot[]
  weeklyDiagnostics  WeeklyDiagnostic[]
  aiRecommendations  AIRecommendation[]
  programEnrollment  ProgramEnrollment?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// Learner Profile & Goals
// ============================================================

model LearnerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  track            String   @default("general") // student, professional, general
  primaryGoals     String   @default("[]")  // JSON array
  primaryDifficulty String?
  nativeLanguage   String?
  proficiencyLevel String?  // estimated: A2, B1, B2, C1
  timezone         String?
  dailyGoalMinutes Int      @default(35)
  preferredMode    String   @default("full") // full, express
  onboardingComplete Boolean @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pronunciationProfile PronunciationProfile?
  errorPatterns        LearnerErrorPattern[]
}

model ProgramEnrollment {
  id           String    @id @default(cuid())
  userId       String    @unique
  programId    String    @default("30-day-communication")
  track        String    @default("general")
  startDate    DateTime  @default(now())
  targetEndDate DateTime?
  status       String    @default("active") // active, paused, completed, abandoned
  currentDay   Int       @default(1)
  completedDays Int      @default(0)
  week2Unlocked Boolean  @default(false)
  week3Unlocked Boolean  @default(false)
  week4Unlocked Boolean  @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Curriculum & Activities
// ============================================================

model DayProgress {
  id            String    @id @default(cuid())
  userId        String
  dayNumber     Int
  mode          String    @default("full") // full, express
  status        String    @default("not_started") // not_started, in_progress, completed
  startedAt     DateTime?
  completedAt   DateTime?
  currentActivityIndex Int @default(0)
  totalActivities      Int @default(0)
  completedActivities  Int @default(0)
  speakingMinutes      Float @default(0)
  xpEarned             Int @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user             User @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityAttempts ActivityAttempt[]

  @@unique([userId, dayNumber])
}

model ActivityAttempt {
  id              String    @id @default(cuid())
  userId          String
  dayProgressId   String?
  dayNumber       Int
  activityType    String    // confidence_check, recording, timed_speaking, etc.
  activityId      String    // unique activity identifier within the day
  attemptNumber   Int       @default(1)
  status          String    @default("not_started") // not_started, in_progress, completed, skipped
  mode            String    @default("full") // full, express
  responseData    String?   // JSON - activity-specific response data
  score           Float?
  feedback        String?   // JSON - AI feedback
  duration        Float?    // seconds
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayProgress  DayProgress? @relation(fields: [dayProgressId], references: [id])
  recordings   Recording[]

  @@index([userId, dayNumber, activityId])
}

// ============================================================
// Audio & Speech
// ============================================================

model Recording {
  id              String    @id @default(cuid())
  userId          String
  attemptId       String?
  label           String?   // "Baseline Recording — Day 1", "Day 2 Fluency Recording"
  purpose         String?   // baseline, practice, challenge, retry, conversation
  dayNumber       Int
  filePath        String    // relative path to stored file
  fileSize        Int?      // bytes
  mimeType        String?
  durationSeconds Float?
  isBaseline      Boolean   @default(false)
  consentGiven    Boolean   @default(true)
  createdAt       DateTime  @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt   ActivityAttempt?  @relation(fields: [attemptId], references: [id])
  transcript Transcript?
  analysis   SpeechAnalysis?
}

model Transcript {
  id           String   @id @default(cuid())
  recordingId  String   @unique
  text         String
  words        String?  // JSON array of word-level data if available
  provider     String   // openai_whisper, google_stt, etc.
  providerVersion String?
  confidence   Float?
  language     String?
  createdAt    DateTime @default(now())

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
}

model SpeechAnalysis {
  id                String   @id @default(cuid())
  recordingId       String   @unique
  provider          String   // openai, gemini, etc.
  providerVersion   String?
  modelUsed         String?

  // Measurable metrics
  wordCount         Int?
  speakingDuration  Float?   // seconds
  wordsPerMinute    Float?
  responseStartDelay Float?  // seconds
  fillerCount       Int?
  fillerWords       String?  // JSON - specific fillers detected
  longPauseCount    Int?
  longPauses        String?  // JSON - pause locations/durations
  uniqueWordCount   Int?
  vocabularyDiversity Float? // unique/total ratio
  repeatedWords     String?  // JSON

  // AI-assessed dimensions (coaching signals, not scores)
  fluencyRating     Float?   // 1-10
  structureRating   Float?   // 1-10
  vocabularyRating  Float?   // 1-10
  grammarRating     Float?   // 1-10
  clarityRating     Float?   // 1-10
  confidenceRating  Float?   // 1-10

  // Detailed observations
  grammarPatterns   String?  // JSON
  pronunciationNotes String? // JSON
  structureNotes    String?  // JSON
  strengths         String?  // JSON array
  improvements      String?  // JSON array
  corrections       String?  // JSON array

  createdAt         DateTime @default(now())

  recording Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
}

// ============================================================
// Confidence & Skills
// ============================================================

model ConfidenceCheck {
  id        String   @id @default(cuid())
  userId    String
  dayNumber Int
  type      String   @default("pre") // pre, post, baseline
  ratings   String   // JSON object: { speaking: 7, vocabulary: 6, ... }
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayNumber])
}

model SkillSnapshot {
  id              String   @id @default(cuid())
  userId          String
  dayNumber       Int
  snapshotType    String   @default("daily") // daily, weekly, baseline
  fluency         Float?
  vocabulary      Float?
  grammar         Float?
  pronunciation   Float?
  structure       Float?
  conversation    Float?
  listening       Float?
  confidence      Float?
  storytelling    Float?
  speakingWpm     Float?
  avgResponseDelay Float?
  fillerRate      Float?   // fillers per minute
  evidenceJson    String?  // JSON - detailed evidence
  scoringVersion  String?  // version of scoring algorithm
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayNumber])
}

model LearnerErrorPattern {
  id              String   @id @default(cuid())
  learnerProfileId String
  category        String   // grammar, vocabulary, pronunciation, fluency, conversation
  pattern         String   // e.g., "missing third-person s", "I am working since"
  severity        String   @default("medium") // low, medium, high
  frequency       Int      @default(1)
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @default(now())
  corrected       Boolean  @default(false)
  correction      String?
  examples        String?  // JSON array of examples
  priority        Int      @default(0) // higher = more important to fix

  learnerProfile LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)

  @@index([learnerProfileId, category])
}

model PronunciationProfile {
  id                String   @id @default(cuid())
  learnerProfileId  String   @unique
  strongAreas       String?  // JSON
  developingAreas   String?  // JSON
  priorityPractice  String?  // JSON - specific sounds/patterns to work on
  stressClarity     Float?
  rhythmRating      Float?
  intonationRating  Float?
  listenerClarity   Float?
  lastUpdated       DateTime @default(now())

  learnerProfile LearnerProfile @relation(fields: [learnerProfileId], references: [id], onDelete: Cascade)
}

// ============================================================
// Vocabulary
// ============================================================

model VocabularyItem {
  id           String   @id @default(cuid())
  expression   String
  meaning      String?
  example      String?
  category     String?  // opinion, example, contrast, conclusion, collocation, etc.
  dayIntroduced Int?
  track        String?  // student, professional, general, all
  difficulty   String   @default("intermediate")
  createdAt    DateTime @default(now())

  learnerVocabulary LearnerVocabulary[]

  @@unique([expression, track])
}

model LearnerVocabulary {
  id              String   @id @default(cuid())
  userId          String
  vocabularyItemId String
  status          String   @default("discovered") // discovered, understood, recognized, completed, produced, spoken, recycled, active
  timesEncountered Int     @default(1)
  timesUsedInSpeech Int    @default(0)
  lastEncountered  DateTime @default(now())
  lastUsedInSpeech DateTime?
  nextReviewDate   DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vocabularyItem VocabularyItem @relation(fields: [vocabularyItemId], references: [id])

  @@unique([userId, vocabularyItemId])
}

// ============================================================
// Gamification
// ============================================================

model XpLedger {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  source      String   // activity_completed, recording_completed, badge_awarded, etc.
  sourceId    String?  // reference to the activity/badge
  description String?
  dayNumber   Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Badge {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  icon        String  // emoji or icon reference
  category    String  // completion, skill, milestone, special
  dayRequired Int?    // which day awards this badge
  criteria    String? // JSON - conditions for earning

  awards BadgeAward[]
}

model BadgeAward {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  dayNumber Int?
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
}

model Streak {
  id             String   @id @default(cuid())
  userId         String   @unique
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActivityDate DateTime?
  streakStartDate  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Missions
// ============================================================

model MissionCompletion {
  id          String    @id @default(cuid())
  userId      String
  dayNumber   Int
  missionId   String
  status      String    @default("pending") // pending, completed, skipped
  notes       String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayNumber, missionId])
}

// ============================================================
// Analytics & Diagnostics
// ============================================================

model WeeklyDiagnostic {
  id               String   @id @default(cuid())
  userId           String
  weekNumber       Int
  overallScore     Float?
  strongestArea    String?
  primaryWeakness  String?
  secondaryWeakness String?
  recommendations  String?  // JSON
  baselineComparison String? // JSON - Day 1 vs Day 7 etc.
  vocabularyActive Int?
  vocabularyTotal  Int?
  pronunciationFocus String? // JSON
  nextWeekPriorities String? // JSON
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber])
}

model AIRecommendation {
  id          String   @id @default(cuid())
  userId      String
  dayNumber   Int?
  type        String   // vocabulary, grammar, pronunciation, activity, difficulty
  content     String   // JSON
  applied     Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Privacy, Security & Compliance
// ============================================================

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  consentType String   // recording, analytics, data_processing
  granted     Boolean  @default(true)
  version     String   @default("1.0")
  ipAddress   String?
  grantedAt   DateTime @default(now())
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String   // recording_created, profile_updated, data_exported, etc.
  resource   String?  // resource type
  resourceId String?
  metadata   String?  // JSON - non-sensitive details
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, action])
  @@index([createdAt])
}

model FeatureFlag {
  id          String  @id @default(cuid())
  key         String  @unique
  enabled     Boolean @default(false)
  description String?
  metadata    String? // JSON - rollout percentage, user segments, etc.
}
